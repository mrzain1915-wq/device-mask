<?xml version="1.0" encoding="utf-8"?>
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- v1.0.28: Android 11+ package visibility hides other apps unless
         the app declares them here. Without this, getPackageInfo for
         the LSPosed manager always failed and Diagnose wrongly showed
         "not installed" even though the manager IS installed. -->
    <queries>
        <package android:name="org.lsposed.manager" />
        <package android:name="com.android.lsposed.manager" />
    </queries>

    <application
        android:label="@string/app_name"
        android:description="@string/app_description"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Receives the hook's "module ran" broadcast and records only
             the time it happened. The broadcast comes from a hooked
             target app's process, so the receiver must be exported;
             setPackage("com.device.mask") on the sending side restricts
             it to this app. Same pattern as SureSIM's CopyEventReceiver. -->
        <receiver
            android:name=".ActiveEventReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.device.mask.ACTION_MODULE_ACTIVE" />
            </intent-filter>
        </receiver>

        <!-- Second activation channel (v1.0.28): the hook also writes
             the "module ran" marker through this ContentProvider, so the
             card turns green even if the activation broadcast is
             dropped. The provider is exported because the call comes
             from a hooked target app's process; it accepts only the
             "activate" path and writes only the time. -->
        <provider
            android:name=".ActivationProvider"
            android:authorities="com.device.mask.activation"
            android:exported="true" />
    </application>
</manifest>
